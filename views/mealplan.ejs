<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="padding-top: 60px; padding-bottom: 80px;">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 28px;">
    <div>
      <h1 style="font-size: 34px; font-weight: 800; margin-bottom: 6px; line-height: 1.2;">Meal Planning</h1>
      <p style="color: var(--muted); font-size: 16px;">Generate and save custom AI-powered meal plans for the week</p>
    </div>

    <!-- Navigation Tabs -->
    <div style="display: flex; gap: 8px; background: var(--border); padding: 4px; border-radius: 12px;">
      <button id="tab-btn-create" onclick="switchTab('create')" style="padding: 10px 20px; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; background: var(--primary); color: #fff; transition: all .2s;">
        Generate Plan
      </button>
      <button id="tab-btn-saved" onclick="switchTab('saved')" style="padding: 10px 20px; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; background: transparent; color: var(--muted); transition: all .2s;">
        Saved Plans (<span id="saved-count"><%= (typeof savedPlans !== 'undefined' ? savedPlans.length : 0) %></span>)
      </button>
    </div>
  </div>

  <!-- Toast notification -->
  <div id="toast" style="display: none; position: fixed; bottom: 30px; right: 30px; background: #10B981; color: #fff; padding: 14px 24px; border-radius: 10px; font-weight: 700; font-size: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.2); z-index: 1000; animation: slideUp .3s ease;">
    <span id="toast-msg">Saved successfully!</span>
  </div>

  <!-- TAB 1: CREATE / GENERATE PLAN -->
  <div id="view-create">
    <div style="max-width: 520px; margin-bottom: 40px; background: var(--surface); padding: 26px; border-radius: var(--radius); box-shadow: var(--shadow);">
      <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 18px;">Customize Your Plan</h3>
      <div style="margin-bottom: 16px;">
        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 6px;">Diet Preference</label>
        <select id="diet" style="width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; font-family: inherit; background: var(--bg); outline: none;">
          <option value="vegetarian">Vegetarian</option>
          <option value="vegan">Vegan</option>
          <option value="non-vegetarian">Non-Vegetarian</option>
          <option value="keto">Keto / Low-Carb</option>
          <option value="any">Any / Balanced</option>
        </select>
      </div>
      <div style="margin-bottom: 22px;">
        <label style="font-size: 14px; font-weight: 600; display: block; margin-bottom: 6px;">Number of Days</label>
        <select id="days" style="width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 14px; font-family: inherit; background: var(--bg); outline: none;">
          <option value="3">3 Days (Mini Plan)</option>
          <option value="5">5 Days (Work Week)</option>
          <option value="7" selected>7 Days (Full Week)</option>
        </select>
      </div>
      <button id="generate-btn" onclick="generatePlan()" style="width: 100%; padding: 14px; background: var(--primary); color: #fff; border: none; border-radius: var(--radius-sm); font-size: 16px; font-weight: 700; cursor: pointer; transition: background .2s;" onmouseover="this.style.background='var(--primary-dark)'" onmouseout="this.style.background='var(--primary)'">
        Generate Meal Plan
      </button>
    </div>

    <div id="loading" style="display: none; text-align: center; padding: 40px 0;">
      <p style="color: var(--primary); font-weight: 700; font-size: 20px; margin-bottom: 6px;">
        AI is planning your meals... <span id="elapsed" style="color: var(--muted); font-size: 16px; font-weight: 500;"></span>
      </p>
      <p style="color: var(--muted); font-size: 14px;">Balancing nutrition, variety, and easy recipes</p>
    </div>

    <!-- Generated Plan Section -->
    <div id="plan-section" style="display: none;">
      <div style="background: var(--surface); padding: 18px 24px; border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div>
          <h2 id="plan-heading" style="font-size: 22px; font-weight: 800; color: var(--text);">Weekly Meal Plan</h2>
          <p id="plan-subheading" style="color: var(--muted); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Ready for your week</p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
          <% if (user) { %>
            <button id="save-plan-btn" onclick="saveCurrentMealPlan()" style="padding: 12px 24px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(124,58,237,.3); transition: all .2s;" onmouseover="this.style.background='var(--primary-dark)'" onmouseout="this.style.background='var(--primary)'">
              <span>💾</span> Save Meal Plan
            </button>
          <% } else { %>
            <a href="/login" style="padding: 12px 24px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
              Log in to Save Plan
            </a>
          <% } %>
        </div>
      </div>

      <div id="plan-grid" style="display: grid; gap: 24px;"></div>
    </div>
  </div>

  <!-- TAB 2: SAVED MEAL PLANS -->
  <div id="view-saved" style="display: none;">
    <div id="saved-plans-container">
      <% if (typeof savedPlans === 'undefined' || savedPlans.length === 0) { %>
        <div style="background: var(--surface); border-radius: var(--radius); padding: 60px 20px; text-align: center; box-shadow: var(--shadow);">
          <div style="font-size: 48px; margin-bottom: 12px;">📅</div>
          <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 8px;">No saved meal plans yet</h3>
          <p style="color: var(--muted); font-size: 15px; margin-bottom: 24px; max-width: 400px; margin-left: auto; margin-right: auto;">
            Generate your first meal plan and click "Save Meal Plan" to keep it here for easy reference!
          </p>
          <button onclick="switchTab('create')" style="padding: 12px 28px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer;">
            Generate a Meal Plan
          </button>
        </div>
      <% } else { %>
        <div style="display: grid; gap: 24px;">
          <% savedPlans.forEach(function(sp, idx) { %>
            <div id="saved-card-<%- sp._id %>" style="background: var(--surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);">
              <div style="padding: 22px 26px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                    <h3 style="font-size: 20px; font-weight: 800;"><%- sp.title %></h3>
                    <span style="background: var(--primary-light); color: var(--primary); padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; text-transform: uppercase;">
                      <%- sp.diet %>
                    </span>
                    <span style="background: #E0E7FF; color: #4338CA; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                      <%- sp.days %> Days
                    </span>
                  </div>
                  <p style="color: var(--muted); font-size: 13px;">
                    Saved on <%= new Date(sp.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </p>
                </div>

                <div style="display: flex; gap: 10px; align-items: center;">
                  <button onclick="togglePlanDetails('<%- sp._id %>')" id="toggle-btn-<%- sp._id %>" style="padding: 8px 16px; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">
                    View Details ▼
                  </button>
                  <button onclick="deleteMealPlan('<%- sp._id %>')" title="Delete plan" style="padding: 8px 14px; background: #FEE2E2; color: #DC2626; border: none; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; transition: background .2s;" onmouseover="this.style.background='#FECACA'" onmouseout="this.style.background='#FEE2E2'">
                    Delete
                  </button>
                </div>
              </div>

              <!-- Collapsible Plan Days -->
              <div id="details-<%- sp._id %>" style="display: none; padding: 24px; background: #FAFAFD;">
                <div style="display: grid; gap: 18px;">
                  <% (sp.plan || []).forEach(function(day) { %>
                    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 18px 22px;">
                      <h4 style="font-size: 17px; font-weight: 800; color: var(--primary); margin-bottom: 12px;"><%- day.day %></h4>
                      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
                        <% (day.meals || []).forEach(function(m) { %>
                          <div style="background: var(--bg); padding: 12px 16px; border-radius: 8px;">
                            <p style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase;"><%- m.meal %></p>
                            <p style="font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 6px;"><%- m.dish %></p>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px;">
                              <% (m.ingredients || []).forEach(function(ing) { %>
                                <span style="background: var(--primary-light); color: var(--primary-dark); font-size: 11px; padding: 2px 6px; border-radius: 4px; font-weight: 600;"><%- ing %></span>
                              <% }) %>
                            </div>
                            <ol style="padding-left: 16px; font-size: 12px; color: #4B5563; line-height: 1.5;">
                              <% (m.steps || []).forEach(function(s) { %>
                                <li><%- s %></li>
                              <% }) %>
                            </ol>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  window.currentPlanData = null;
  window.currentDiet = 'vegetarian';
  window.currentDays = 7;

  function showToast(msg) {
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toast-msg');
    toastMsg.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 3500);
  }

  function switchTab(tab) {
    const viewCreate = document.getElementById('view-create');
    const viewSaved = document.getElementById('view-saved');
    const btnCreate = document.getElementById('tab-btn-create');
    const btnSaved = document.getElementById('tab-btn-saved');

    if (tab === 'create') {
      viewCreate.style.display = 'block';
      viewSaved.style.display = 'none';
      btnCreate.style.background = 'var(--primary)';
      btnCreate.style.color = '#fff';
      btnSaved.style.background = 'transparent';
      btnSaved.style.color = 'var(--muted)';
    } else {
      viewCreate.style.display = 'none';
      viewSaved.style.display = 'block';
      btnSaved.style.background = 'var(--primary)';
      btnSaved.style.color = '#fff';
      btnCreate.style.background = 'transparent';
      btnCreate.style.color = 'var(--muted)';
    }
  }

  function togglePlanDetails(id) {
    const details = document.getElementById('details-' + id);
    const btn = document.getElementById('toggle-btn-' + id);
    if (details.style.display === 'none' || !details.style.display) {
      details.style.display = 'block';
      btn.textContent = 'Hide Details ▲';
    } else {
      details.style.display = 'none';
      btn.textContent = 'View Details ▼';
    }
  }

  async function generatePlan() {
    const diet = document.getElementById('diet').value;
    const days = parseInt(document.getElementById('days').value);
    const grid = document.getElementById('plan-grid');
    const loadingEl = document.getElementById('loading');
    const planSection = document.getElementById('plan-section');
    const elapsedSpan = document.getElementById('elapsed');
    const planHeading = document.getElementById('plan-heading');
    const saveBtn = document.getElementById('save-plan-btn');

    loadingEl.style.display = 'block';
    planSection.style.display = 'none';
    const started = Date.now();
    const timer = setInterval(() => {
      elapsedSpan.textContent = Math.round((Date.now() - started) / 1000) + 's';
    }, 1000);

    try {
      const res = await fetch('/api/mealplan/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ diet, days }),
        signal: AbortSignal.timeout(60000)
      });
      const data = await res.json();
      if (data.error) throw new Error(data.error);

      window.currentPlanData = data.plan;
      window.currentDiet = diet;
      window.currentDays = days;

      planHeading.textContent = `${diet.charAt(0).toUpperCase() + diet.slice(1)} ${days}-Day Meal Plan`;
      grid.innerHTML = data.html;

      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.style.opacity = '1';
        saveBtn.innerHTML = '<span>💾</span> Save Meal Plan';
      }

      loadingEl.style.display = 'none';
      planSection.style.display = 'block';
      planSection.scrollIntoView({ behavior: 'smooth' });
    } catch (err) {
      loadingEl.style.display = 'none';
      alert(err.name === 'TimeoutError'
        ? 'AI took too long to respond. Try again with fewer days.'
        : (err.message || 'Failed to generate plan'));
    } finally {
      clearInterval(timer);
      elapsedSpan.textContent = '';
    }
  }

  async function saveCurrentMealPlan() {
    if (!window.currentPlanData || window.currentPlanData.length === 0) {
      alert('Please generate a meal plan first!');
      return;
    }

    const saveBtn = document.getElementById('save-plan-btn');
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }

    try {
      const diet = window.currentDiet || 'any';
      const days = window.currentDays || 7;
      const title = `${diet.charAt(0).toUpperCase() + diet.slice(1)} ${days}-Day Meal Plan`;

      const res = await fetch('/api/mealplan/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          diet,
          days,
          plan: window.currentPlanData
        })
      });

      const data = await res.json();
      if (data.error) throw new Error(data.error);

      if (data.saved) {
        if (saveBtn) {
          saveBtn.style.background = '#10B981';
          saveBtn.innerHTML = '<span>✓</span> Saved to Meal Plans';
        }
        showToast('✓ Meal plan saved successfully!');

        // Update count badge
        const countSpan = document.getElementById('saved-count');
        if (countSpan) {
          countSpan.textContent = parseInt(countSpan.textContent || '0') + 1;
        }
      }
    } catch (err) {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<span>💾</span> Save Meal Plan';
      }
      alert(err.message || 'Failed to save meal plan');
    }
  }

  async function deleteMealPlan(id) {
    if (!confirm('Are you sure you want to remove this saved meal plan?')) return;
    try {
      const res = await fetch('/api/mealplan/save/' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.deleted) {
        const card = document.getElementById('saved-card-' + id);
        if (card) {
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          card.style.transition = 'all .3s ease';
          setTimeout(() => card.remove(), 300);
        }
        showToast('Meal plan removed');
        const countSpan = document.getElementById('saved-count');
        if (countSpan) {
          countSpan.textContent = Math.max(0, parseInt(countSpan.textContent || '1') - 1);
        }
      }
    } catch {
      alert('Failed to delete meal plan');
    }
  }

  async function saveMealDish(dish) {
    try {
      const res = await fetch('/api/mealplan/save-dish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: dish.title || dish.dish,
          ingredients: dish.ingredients || [],
          steps: dish.steps || []
        })
      });
      const data = await res.json();
      if (data.saved) {
        showToast(`✓ "${dish.title || dish.dish}" saved to your Recipes!`);
      }
    } catch {
      alert('Failed to save dish');
    }
  }
</script>

</body>
</html>
