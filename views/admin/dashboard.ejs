<%- include('../partials/header') %>
<%- include('../partials/adminNavbar') %>

<style>
  .stat-card {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 28px 24px;
    box-shadow: var(--shadow);
    text-align: center;
  }
  .stat-card .num {
    font-size: 48px;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-card .label {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }
</style>

<div class="container" style="padding-top: 60px; padding-bottom: 80px;">
  <h1 style="font-size: 32px; font-weight: 800; margin-bottom: 4px;">Admin Dashboard</h1>
  <p style="color: var(--muted); font-size: 15px; margin-bottom: 8px;">Overview of your CookingAI app</p>

  <div class="admin-grid">
    <div class="stat-card">
      <div class="num"><%= totalUsers %></div>
      <div class="label">Total Users</div>
    </div>
    <div class="stat-card">
      <div class="num"><%= totalRecipes %></div>
      <div class="label">Saved Recipes</div>
    </div>
  </div>

  <div style="margin-top: 40px; display: flex; gap: 16px;">
    <a href="/admin/users" style="display: inline-block; padding: 14px 32px; background: var(--primary); color: #fff; border-radius: var(--radius-sm); font-weight: 700; font-size: 15px;">Manage Users</a>
    <a href="/admin/recipes" style="display: inline-block; padding: 14px 32px; background: var(--surface); color: var(--primary); border: 2px solid var(--primary); border-radius: var(--radius-sm); font-weight: 700; font-size: 15px;">Manage Recipes</a>
  </div>
</div>

</body>
</html>